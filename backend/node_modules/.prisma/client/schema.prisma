// ==========================================
// ACCOUNTING & FINANCE MODELS (DOUBLE-ENTRY)
// ==========================================

model ChartOfAccount {
  id        String         @id @default(uuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  code      String
  name      String
  type      AccountType
  subType   AccountSubType
  balance   Decimal        @default(0) @db.Decimal(12, 4)
  isSystem  Boolean        @default(false)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  journalLines     JournalEntryLine[]
  expenseEntries   ExpenseEntry[]     @relation("ExpenseAccount")
  paidFromExpenses ExpenseEntry[]     @relation("PaidFromAccount")

  @@unique([companyId, code])
  @@map("acc_chart_of_accounts")
}

model JournalEntry {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  entryNumber   String        @unique
  date          DateTime      @default(now())
  referenceType String // POS_SALE, HOTEL_FOLIO_BILLING, HOTEL_NIGHT_AUDIT, PURCHASE_INVOICE, EXPENSE_PAYMENT, GENERAL_JOURNAL
  referenceId   String?
  narration     String
  status        JournalStatus @default(POSTED)
  totalDebit    Decimal       @db.Decimal(12, 4)
  totalCredit   Decimal       @db.Decimal(12, 4)
  createdById   String?
  createdBy     User?         @relation("JournalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines JournalEntryLine[]

  @@map("acc_journal_entries")
}

model JournalEntryLine {
  id             String         @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  debit          Decimal        @default(0) @db.Decimal(12, 4)
  credit         Decimal        @default(0) @db.Decimal(12, 4)
  narration      String?

  @@map("acc_journal_entry_lines")
}

model AccountsPayable {
  id            String     @id @default(uuid())
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplierId    String
  supplier      Supplier   @relation(fields: [supplierId], references: [id])
  invoiceNumber String
  invoiceDate   DateTime   @default(now())
  dueDate       DateTime?
  amount        Decimal    @db.Decimal(12, 4)
  paidAmount    Decimal    @default(0) @db.Decimal(12, 4)
  balance       Decimal    @db.Decimal(12, 4)
  status        APARStatus @default(UNPAID)
  referenceType String? // GRN, PURCHASE_INVOICE
  referenceId   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("acc_accounts_payable")
}

model AccountsReceivable {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  guestId       String?
  guest         GuestProfile? @relation(fields: [guestId], references: [id], onDelete: SetNull)
  bookingId     String?
  booking       Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  invoiceNumber String
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime?
  amount        Decimal       @db.Decimal(12, 4)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 4)
  balance       Decimal       @db.Decimal(12, 4)
  status        APARStatus    @default(UNPAID)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("acc_accounts_receivable")
}

model ExpenseEntry {
  id                String         @id @default(uuid())
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId          String?
  branch            Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  expenseNumber     String         @unique
  category          String
  expenseAccountId  String
  expenseAccount    ChartOfAccount @relation("ExpenseAccount", fields: [expenseAccountId], references: [id])
  paidFromAccountId String
  paidFromAccount   ChartOfAccount @relation("PaidFromAccount", fields: [paidFromAccountId], references: [id])
  amount            Decimal        @db.Decimal(12, 4)
  taxAmount         Decimal        @default(0) @db.Decimal(12, 4)
  paymentMethod     PaymentMethod  @default(CASH)
  paidTo            String
  date              DateTime       @default(now())
  receiptUrl        String?
  notes             String?
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("acc_expense_entries")
}

// ==========================================
// SECTION 12: HR & PAYROLL MODULE
// ==========================================

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  PROBATION
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PROCESSED
  PAID
}

model Department {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name        String
  code        String
  description String?
  headId      String?
  head        User?    @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@unique([companyId, code])
  @@map("hr_departments")
}

model Employee {
  id               String         @id @default(uuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentId     String?
  department       Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  userId           String?        @unique
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeCode     String         @unique
  firstName        String
  lastName         String
  email            String?
  phone            String?
  designation      String
  employmentType   EmploymentType @default(FULL_TIME)
  joinDate         DateTime       @default(now())
  basicSalary      Decimal        @db.Decimal(12, 4)
  allowances       Decimal        @default(0) @db.Decimal(12, 4)
  bankAccount      String?
  nidOrPassport    String?
  emergencyContact String?
  status           EmployeeStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  documents     EmployeeDocument[]
  attendances   Attendance[]
  leaveRequests LeaveRequest[]
  payslips      Payslip[]

  @@map("hr_employees")
}

model EmployeeDocument {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title        String
  documentType String
  fileUrl      String
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("hr_employee_documents")
}

model Shift {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name            String
  code            String
  startTime       String // e.g. "08:00"
  endTime         String // e.g. "17:00"
  gracePeriodMins Int      @default(15)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attendances Attendance[]

  @@map("hr_shifts")
}

model Attendance {
  id            String           @id @default(uuid())
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId       String?
  shift         Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  date          DateTime         @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  status        AttendanceStatus @default(PRESENT)
  workHours     Decimal?         @db.Decimal(5, 2)
  overtimeHours Decimal?         @default(0) @db.Decimal(5, 2)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([employeeId, date])
  @@map("hr_attendances")
}

model LeaveType {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  code        String
  daysAllowed Int      @default(14)
  isPaid      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests LeaveRequest[]

  @@unique([companyId, code])
  @@map("hr_leave_types")
}

model LeaveRequest {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     String
  leaveType       LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  totalDays       Int
  reason          String
  status          LeaveStatus @default(PENDING)
  approvedById    String?
  approvedBy      User?       @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("hr_leave_requests")
}

model PayrollRun {
  id               String        @id @default(uuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  payrollNumber    String        @unique
  month            Int
  year             Int
  totalGrossSalary Decimal       @db.Decimal(12, 4)
  totalDeductions  Decimal       @default(0) @db.Decimal(12, 4)
  totalNetSalary   Decimal       @db.Decimal(12, 4)
  status           PayrollStatus @default(DRAFT)
  runDate          DateTime      @default(now())
  processedById    String?
  processedBy      User?         @relation("PayrollProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  payslips Payslip[]

  @@unique([companyId, month, year])
  @@map("hr_payroll_runs")
}

model Payslip {
  id             String        @id @default(uuid())
  payrollRunId   String
  payrollRun     PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id])
  basicSalary    Decimal       @db.Decimal(12, 4)
  allowances     Decimal       @default(0) @db.Decimal(12, 4)
  overtimeAmount Decimal       @default(0) @db.Decimal(12, 4)
  deductions     Decimal       @default(0) @db.Decimal(12, 4)
  netSalary      Decimal       @db.Decimal(12, 4)
  paymentStatus  PaymentStatus @default(PENDING)
  paidAt         DateTime?
  paymentMethod  PaymentMethod @default(CASH)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([payrollRunId, employeeId])
  @@map("hr_payslips")
}

// ==========================================
// SECTION 13: APPROVAL CENTER ENGINE
// ==========================================

enum ApprovalType {
  PURCHASE_REQUEST
  PURCHASE_ORDER
  EXPENSE
  STOCK_ADJUSTMENT
  STOCK_TRANSFER
  DISCOUNT
  REFUND
  SALARY_CHANGE
  PERMISSION_CHANGE
}

model ApprovalRule {
  id              String       @id @default(uuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  transactionType ApprovalType
  minAmount       Decimal      @default(0) @db.Decimal(12, 4)
  requiredRole    String
  stepNumber      Int          @default(1)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("approval_rules")
}

model ApprovalRequest {
  id              String         @id @default(uuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  requestNumber   String         @unique
  transactionType ApprovalType
  referenceId     String
  amount          Decimal?       @db.Decimal(12, 4)
  title           String
  description     String?
  status          ApprovalStatus @default(PENDING)
  requestedById   String
  requestedBy     User           @relation("ApprovalRequester", fields: [requestedById], references: [id])
  currentStep     Int            @default(1)
  totalSteps      Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  actions ApprovalAction[]

  @@map("approval_requests")
}

model ApprovalAction {
  id                String          @id @default(uuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation("ApprovalActor", fields: [userId], references: [id])
  userRole          String
  action            ApprovalStatus
  previousStatus    ApprovalStatus
  newStatus         ApprovalStatus
  comment           String?
  createdAt         DateTime        @default(now())

  @@map("approval_actions")
}
