  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories MenuCategory[]
  menuItems  MenuItem[]

  @@unique([companyId, code])
  @@map("menus")
}

model MenuCategory {
  id        String   @id @default(uuid())
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name      String
  code      String
  sortOrder Int      @default(0)
  icon      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItems MenuItem[]

  @@unique([menuId, code])
  @@map("menu_categories")
}

model MenuItem {
  id                 String         @id @default(uuid())
  companyId          String
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  menuId             String
  menu               Menu           @relation(fields: [menuId], references: [id], onDelete: Cascade)
  categoryId         String
  category           MenuCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  finishedItemId     String?
  finishedItem       Item?          @relation(fields: [finishedItemId], references: [id], onDelete: SetNull)
  recipeId           String?
  recipe             Recipe?        @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  name               String
  code               String
  description        String?
  price              Decimal        @db.Decimal(12, 4)
  costPrice          Decimal        @default(0) @db.Decimal(12, 4)
  taxRate            Decimal        @default(0) @db.Decimal(5, 2)
  kitchenStation     KitchenStation @default(MAIN_KITCHEN)
  preparationMinutes Int            @default(15)
  isAvailable        Boolean        @default(true)
  imageUrl           String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  orderItems OrderItem[]

  @@unique([companyId, code])
  @@map("menu_items")
}

model DiningTable {
  id            String      @id @default(uuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableNumber   String
  name          String?
  capacity      Int         @default(4)
  section       String      @default("Main Dining")
  status        TableStatus @default(AVAILABLE)
  activeOrderId String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orders RestaurantOrder[]

  @@unique([branchId, tableNumber])
  @@map("dining_tables")
}

model RestaurantOrder {
  id             String       @id @default(uuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orderNumber    String       @unique
  tableId        String?
  table          DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  orderType      OrderType    @default(DINE_IN)
  status         OrderStatus  @default(OPEN)
  guestCount     Int          @default(1)
  customerName   String?
  customerPhone  String?
  subtotal       Decimal      @default(0) @db.Decimal(12, 4)
  discountAmount Decimal      @default(0) @db.Decimal(12, 4)
  taxAmount      Decimal      @default(0) @db.Decimal(12, 4)
  serviceCharge  Decimal      @default(0) @db.Decimal(12, 4)
  grandTotal     Decimal      @default(0) @db.Decimal(12, 4)
  paidAmount     Decimal      @default(0) @db.Decimal(12, 4)
  waiterId       String?
  waiter         User?        @relation("WaiterOrders", fields: [waiterId], references: [id], onDelete: SetNull)
  cashierId      String?
  cashier        User?        @relation("CashierOrders", fields: [cashierId], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items             OrderItem[]
  kitchenTickets    KitchenTicket[]
  payments          Payment[]
  discounts         OrderDiscount[]
  salesRecord       SalesRecord?
  accountingEntries AccountingEntryStub[]

  @@map("restaurant_orders")
}

model OrderItem {
  id         String          @id @default(uuid())
  orderId    String
  order      RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem        @relation(fields: [menuItemId], references: [id])
  name       String
  quantity   Decimal         @db.Decimal(12, 4)
  unitPrice  Decimal         @db.Decimal(12, 4)
  totalPrice Decimal         @db.Decimal(12, 4)
  cogsAmount Decimal         @default(0) @db.Decimal(12, 4)
  notes      String?
  status     OrderItemStatus @default(PENDING)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  kitchenTicketItems KitchenTicketItem[]

  @@map("order_items")
}

model KitchenTicket {
  id           String              @id @default(uuid())
  ticketNumber String
  orderId      String
  order        RestaurantOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch              @relation(fields: [branchId], references: [id])
  station      KitchenStation      @default(MAIN_KITCHEN)
  status       KitchenTicketStatus @default(PENDING)
  ticketType   String              @default("NEW_ORDER")
  notes        String?
  sentAt       DateTime            @default(now())
  preparingAt  DateTime?
  readyAt      DateTime?
  servedAt     DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  items KitchenTicketItem[]

  @@map("kitchen_tickets")
}

model KitchenTicketItem {
  id          String          @id @default(uuid())
  ticketId    String
  ticket      KitchenTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Decimal         @db.Decimal(12, 4)
  status      OrderItemStatus @default(PENDING)
  notes       String?

  @@map("kitchen_ticket_items")
}

model Payment {
  id             String          @id @default(uuid())
  orderId        String
  order          RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Decimal         @db.Decimal(12, 4)
  method         PaymentMethod   @default(CASH)
  status         PaymentStatus   @default(SUCCESS)
  receivedAmount Decimal?        @db.Decimal(12, 4)
  changeAmount   Decimal?        @db.Decimal(12, 4)
  transactionRef String?
  cardLast4      String?
  paymentDate    DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("payments")
}

model OrderDiscount {
  id               String          @id @default(uuid())
  orderId          String
  order            RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountType     DiscountType    @default(PERCENTAGE)
  rateOrAmount     Decimal         @db.Decimal(12, 4)
  amount           Decimal         @db.Decimal(12, 4)
  reason           String
  authorizedById   String?
  authorizedBy     User?           @relation("DiscountAuthorizer", fields: [authorizedById], references: [id], onDelete: SetNull)
  approvalRequired Boolean         @default(false)
  approvalStatus   ApprovalStatus  @default(APPROVED)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("order_discounts")
}

model SalesRecord {
  id             String          @id @default(uuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  orderId        String          @unique
  order          RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber  String          @unique
  saleDate       DateTime        @default(now())
  orderType      OrderType
  grossSales     Decimal         @db.Decimal(12, 4)
  discountAmount Decimal         @default(0) @db.Decimal(12, 4)
  netSales       Decimal         @db.Decimal(12, 4)
  taxAmount      Decimal         @default(0) @db.Decimal(12, 4)
  serviceCharge  Decimal         @default(0) @db.Decimal(12, 4)
  grandTotal     Decimal         @db.Decimal(12, 4)
  totalCogs      Decimal         @default(0) @db.Decimal(12, 4)
  grossProfit    Decimal         @default(0) @db.Decimal(12, 4)
  paymentMethod  PaymentMethod
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("sales_records")
}

model AccountingEntryStub {
  id                String           @id @default(uuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch           @relation(fields: [branchId], references: [id])
  orderId           String?
  order             RestaurantOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  entryNumber       String           @unique
  referenceType     String // e.g. "POS_SALE", "ROOM_CHARGE", "PURCHASE_GRN"
  referenceId       String
  debitAccountCode  String
  debitAccountName  String
  creditAccountCode String
  creditAccountName String
  amount            Decimal          @db.Decimal(12, 4)
  currency          String           @default("USD")
  narration         String
  entryDate         DateTime         @default(now())
  isSynced          Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("accounting_entry_stubs")
}

