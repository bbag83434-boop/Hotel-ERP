generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BranchType {
  RESTAURANT
  HOTEL
  HYBRID
}

enum ItemType {
  RAW_MATERIAL
  FINISHED_GOOD
  SEMI_FINISHED
  PACKAGING
  ASSET
}

enum StockMovementType {
  GRN
  PRODUCTION_IN
  PRODUCTION_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN
  POS_SALE
}

enum PRStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
}

enum PRPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum POStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum GRNStatus {
  RECEIVED
  QC_PASSED
  QC_FAILED
  REJECTED
}

enum QCStatus {
  PASSED
  FAILED
  PENDING
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum ProductionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SupplierTxType {
  INVOICE
  PAYMENT
  RETURN
  ADJUSTMENT
}

model Company {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  email     String?
  phone     String?
  address   String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches             Branch[]
  users                User[]
  categories           Category[]
  units                Unit[]
  items                Item[]
  warehouses           Warehouse[]
  suppliers            Supplier[]
  purchaseRequests     PurchaseRequest[]
  purchaseOrders       PurchaseOrder[]
  grns                 GoodsReceiveNote[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseReturns      PurchaseReturn[]
  recipes              Recipe[]
  productionOrders     ProductionOrder[]
  stockTransfers       StockTransfer[]
  menus                Menu[]
  menuItems            MenuItem[]
  diningTables         DiningTable[]
  restaurantOrders     RestaurantOrder[]
  salesRecords         SalesRecord[]
  accountingEntryStubs AccountingEntryStub[]
  floors               Floor[]
  roomTypes            RoomType[]
  rooms                Room[]
  ratePlans            RatePlan[]
  guestProfiles        GuestProfile[]
  bookings             Booking[]
  housekeepingTasks    HousekeepingTask[]
  maintenanceTickets   MaintenanceTicket[]
  lostAndFounds        LostAndFound[]
  nightAudits          NightAudit[]
  accounts             ChartOfAccount[]
  journalEntries       JournalEntry[]
  payables             AccountsPayable[]
  receivables          AccountsReceivable[]
  expenses             ExpenseEntry[]
  departments          Department[]
  employees            Employee[]
  shifts               Shift[]
  leaveTypes           LeaveType[]
  leaveRequests        LeaveRequest[]
  payrollRuns          PayrollRun[]
  approvalRules        ApprovalRule[]
  approvalRequests     ApprovalRequest[]

  @@map("companies")
}

model Branch {
  id        String     @id @default(uuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  code      String     @unique
  type      BranchType @default(HYBRID)
  email     String?
  phone     String?
  address   String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  userBranches         UserBranch[]
  warehouses           Warehouse[]
  purchaseRequests     PurchaseRequest[]
  purchaseOrders       PurchaseOrder[]
  grns                 GoodsReceiveNote[]
  productionOrders     ProductionOrder[]
  menus                Menu[]
  diningTables         DiningTable[]
  restaurantOrders     RestaurantOrder[]
  kitchenTickets       KitchenTicket[]
  salesRecords         SalesRecord[]
  accountingEntryStubs AccountingEntryStub[]
  floors               Floor[]
  roomTypes            RoomType[]
  rooms                Room[]
  ratePlans            RatePlan[]
  bookings             Booking[]
  housekeepingTasks    HousekeepingTask[]
  maintenanceTickets   MaintenanceTicket[]
  lostAndFounds        LostAndFound[]
  nightAudits          NightAudit[]
  accounts             ChartOfAccount[]
  journalEntries       JournalEntry[]
  payables             AccountsPayable[]
  receivables          AccountsReceivable[]
  expenses             ExpenseEntry[]
  departments          Department[]
  employees            Employee[]
  shifts               Shift[]
  leaveRequests        LeaveRequest[]
  payrollRuns          PayrollRun[]
  approvalRules        ApprovalRule[]
  approvalRequests     ApprovalRequest[]

  @@map("branches")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(uuid())
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  email        String    @unique
  username     String    @unique
  passwordHash String
  firstName    String
  lastName     String?
  phone        String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  refreshToken String?   @db.Text
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branches                   UserBranch[]
  auditLogs                  AuditLog[]
  requestedPurchaseRequests  PurchaseRequest[]   @relation("PRRequester")
  approvedPurchaseRequests   PurchaseRequest[]   @relation("PRApprover")
  createdPurchaseOrders      PurchaseOrder[]
  receivedGRNs               GoodsReceiveNote[]
  createdProductionOrders    ProductionOrder[]
  createdStockTransfers      StockTransfer[]
  createdStockLedgerEntries  StockLedger[]
  waiterOrders               RestaurantOrder[]   @relation("WaiterOrders")
  cashierOrders              RestaurantOrder[]   @relation("CashierOrders")
  authorizedDiscounts        OrderDiscount[]     @relation("DiscountAuthorizer")
  createdBookings            Booking[]           @relation("BookingCreator")
  assignedHousekeepingTasks  HousekeepingTask[]  @relation("Housekeeper")
  assignedMaintenanceTickets MaintenanceTicket[] @relation("MaintenanceAssignee")
  auditedNightAudits         NightAudit[]        @relation("NightAuditor")
  createdJournalEntries      JournalEntry[]      @relation("JournalCreator")
  employee                   Employee?
  managedDepartments         Department[]        @relation("DepartmentHead")
  approvedLeaves             LeaveRequest[]      @relation("LeaveApprover")
  processedPayrolls          PayrollRun[]        @relation("PayrollProcessor")
  requestedApprovals         ApprovalRequest[]   @relation("ApprovalRequester")
  actedApprovals             ApprovalAction[]    @relation("ApprovalActor")

  @@map("users")
}

model UserBranch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@map("user_branches")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// -------------------------------------------------------------
// INVENTORY & WAREHOUSE MODULE
// -------------------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items Item[]

  @@unique([companyId, code])
  @@map("categories")
}

model Unit {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  symbol    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       Item[]
  recipeItems RecipeItem[]

  @@unique([companyId, symbol])
  @@map("units")
}

model Item {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  unitId        String
  unit          Unit     @relation(fields: [unitId], references: [id])
  name          String
  code          String
  barcode       String?
  type          ItemType @default(RAW_MATERIAL)
  description   String?
  costPrice     Decimal  @default(0) @db.Decimal(12, 4)
  sellingPrice  Decimal  @default(0) @db.Decimal(12, 4)
  minStockLevel Decimal  @default(0) @db.Decimal(12, 4)
  reorderQty    Decimal  @default(0) @db.Decimal(12, 4)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stockBalances          StockBalance[]
  stockLedgers           StockLedger[]
  purchaseRequestItems   PurchaseRequestItem[]
  purchaseOrderItems     PurchaseOrderItem[]
  goodsReceiveItems      GoodsReceiveItem[]
  purchaseReturnItems    PurchaseReturnItem[]
  recipesAsFinishedGood  Recipe[]                @relation("FinishedGoodItem")
  recipeItemsAsRaw       RecipeItem[]            @relation("RawMaterialItem")
  productionConsumptions ProductionConsumption[]
  stockTransferItems     StockTransferItem[]
  menuItems              MenuItem[]

  @@unique([companyId, code])
  @@index([companyId, type])
  @@map("items")
}

model Warehouse {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name      String
  code      String
  isCentral Boolean  @default(false)
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockBalances      StockBalance[]
  stockLedgers       StockLedger[]
  grns               GoodsReceiveNote[]
  kitchenProductions ProductionOrder[]  @relation("KitchenWarehouse")
  transfersFrom      StockTransfer[]    @relation("FromWarehouse")
  transfersTo        StockTransfer[]    @relation("ToWarehouse")

  @@unique([companyId, code])
  @@map("warehouses")
}

model StockBalance {
  id            String    @id @default(uuid())
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity      Decimal   @default(0) @db.Decimal(12, 4)
  minStockLevel Decimal?  @db.Decimal(12, 4)
  reorderQty    Decimal?  @db.Decimal(12, 4)
  updatedAt     DateTime  @updatedAt

  @@unique([warehouseId, itemId])
  @@index([warehouseId])
  @@index([itemId])
  @@map("stock_balances")
}

model StockLedger {
  id            String            @id @default(uuid())
  warehouseId   String
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchNumber   String?
  expiryDate    DateTime?
  movementType  StockMovementType
  changeQty     Decimal           @db.Decimal(12, 4)
  balanceQty    Decimal           @db.Decimal(12, 4)
  unitCost      Decimal?          @db.Decimal(12, 4)
  totalCost     Decimal?          @db.Decimal(12, 4)
  referenceType String
  referenceId   String?
  notes         String?
  createdById   String?
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  @@index([warehouseId, itemId])
  @@index([movementType])
  @@index([createdAt])
  @@map("stock_ledgers")
}

model StockTransfer {
  id              String         @id @default(uuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromWarehouseId String
  fromWarehouse   Warehouse      @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse      @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  transferNumber  String         @unique
  status          TransferStatus @default(COMPLETED)
  transferDate    DateTime       @default(now())
  notes           String?
  createdById     String?
  createdBy       User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id         String        @id @default(uuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item          @relation(fields: [itemId], references: [id])
  quantity   Decimal       @db.Decimal(12, 4)
  unitCost   Decimal?      @db.Decimal(12, 4)
  notes      String?

  @@map("stock_transfer_items")
}

// -------------------------------------------------------------
// PURCHASE & PROCUREMENT MODULE
// -------------------------------------------------------------

model Supplier {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  code          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  taxNumber     String?
  paymentTerms  String?  @default("Net 30")
  balance       Decimal  @default(0) @db.Decimal(12, 4)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders   PurchaseOrder[]
  grns             GoodsReceiveNote[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  ledgerEntries    SupplierLedger[]
  payables         AccountsPayable[]

  @@unique([companyId, code])
  @@map("suppliers")
}

model SupplierLedger {
  id              String         @id @default(uuid())
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  transactionType SupplierTxType
  debit           Decimal        @default(0) @db.Decimal(12, 4)
  credit          Decimal        @default(0) @db.Decimal(12, 4)
  balance         Decimal        @db.Decimal(12, 4)
  referenceType   String
  referenceId     String?
  description     String?
  createdAt       DateTime       @default(now())

  @@index([supplierId])
  @@map("supplier_ledgers")
}

model PurchaseRequest {
  id              String     @id @default(uuid())
  companyId       String
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch     @relation(fields: [branchId], references: [id])
  requestNumber   String     @unique
  requestedById   String
  requestedBy     User       @relation("PRRequester", fields: [requestedById], references: [id])
  requiredDate    DateTime
  status          PRStatus   @default(PENDING_APPROVAL)
  priority        PRPriority @default(MEDIUM)
  notes           String?
  approvedById    String?
  approvedBy      User?      @relation("PRApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  items          PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]

  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id             String          @id @default(uuid())
  requestId      String
  request        PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item            @relation(fields: [itemId], references: [id])
  requestedQty   Decimal         @db.Decimal(12, 4)
  estimatedPrice Decimal         @default(0) @db.Decimal(12, 4)
  notes          String?

  @@map("purchase_request_items")
}

model PurchaseOrder {
  id           String           @id @default(uuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch           @relation(fields: [branchId], references: [id])
  supplierId   String
  supplier     Supplier         @relation(fields: [supplierId], references: [id])
  requestId    String?
  request      PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  poNumber     String           @unique
  status       POStatus         @default(ISSUED)
  issueDate    DateTime         @default(now())
  deliveryDate DateTime?
  totalAmount  Decimal          @default(0) @db.Decimal(12, 4)
  taxAmount    Decimal          @default(0) @db.Decimal(12, 4)
  grandTotal   Decimal          @default(0) @db.Decimal(12, 4)
  notes        String?
  createdById  String?
  createdBy    User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  items PurchaseOrderItem[]
  grns  GoodsReceiveNote[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String        @id @default(uuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item          @relation(fields: [itemId], references: [id])
  orderedQty  Decimal       @db.Decimal(12, 4)
  receivedQty Decimal       @default(0) @db.Decimal(12, 4)
  unitPrice   Decimal       @db.Decimal(12, 4)
  totalPrice  Decimal       @db.Decimal(12, 4)
  notes       String?

  goodsReceiveItems GoodsReceiveItem[]

  @@map("purchase_order_items")
}

model GoodsReceiveNote {
  id            String         @id @default(uuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id])
  warehouseId   String
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  supplierId    String
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  poId          String?
  po            PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  grnNumber     String         @unique
  receiveDate   DateTime       @default(now())
  invoiceNumber String?
  status        GRNStatus      @default(QC_PASSED)
  totalAmount   Decimal        @default(0) @db.Decimal(12, 4)
  notes         String?
  receivedById  String?
  receivedBy    User?          @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items            GoodsReceiveItem[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]

  @@map("goods_receive_notes")
}

model GoodsReceiveItem {
  id          String             @id @default(uuid())
  grnId       String
  grn         GoodsReceiveNote   @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItemId    String?
  poItem      PurchaseOrderItem? @relation(fields: [poItemId], references: [id], onDelete: SetNull)
  itemId      String
  item        Item               @relation(fields: [itemId], references: [id])
  receivedQty Decimal            @db.Decimal(12, 4)
  acceptedQty Decimal            @db.Decimal(12, 4)
  rejectedQty Decimal            @default(0) @db.Decimal(12, 4)
  unitPrice   Decimal            @db.Decimal(12, 4)
  totalPrice  Decimal            @db.Decimal(12, 4)
  batchNumber String?
  expiryDate  DateTime?
  qcStatus    QCStatus           @default(PASSED)
  qcNotes     String?

  @@map("goods_receive_items")
}

model PurchaseInvoice {
  id            String            @id @default(uuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier          @relation(fields: [supplierId], references: [id])
  grnId         String?
  grn           GoodsReceiveNote? @relation(fields: [grnId], references: [id], onDelete: SetNull)
  invoiceNumber String            @unique
  invoiceDate   DateTime          @default(now())
  dueDate       DateTime?
  totalAmount   Decimal           @db.Decimal(12, 4)
  paidAmount    Decimal           @default(0) @db.Decimal(12, 4)
  status        InvoiceStatus     @default(UNPAID)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("purchase_invoices")
}

model PurchaseReturn {
  id           String            @id @default(uuid())
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     Supplier          @relation(fields: [supplierId], references: [id])
  grnId        String?
  grn          GoodsReceiveNote? @relation(fields: [grnId], references: [id], onDelete: SetNull)
  returnNumber String            @unique
  returnDate   DateTime          @default(now())
  reason       String
  totalAmount  Decimal           @db.Decimal(12, 4)
  status       String            @default("COMPLETED")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  items PurchaseReturnItem[]

  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id        String         @id @default(uuid())
  returnId  String
  returnDoc PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item           @relation(fields: [itemId], references: [id])
  returnQty Decimal        @db.Decimal(12, 4)
  unitPrice Decimal        @db.Decimal(12, 4)
  notes     String?

  @@map("purchase_return_items")
}

// -------------------------------------------------------------
// PRODUCTION & KITCHEN RECIPE MODULE
// -------------------------------------------------------------

model Recipe {
  id                 String   @id @default(uuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  finishedItemId     String
  finishedItem       Item     @relation("FinishedGoodItem", fields: [finishedItemId], references: [id])
  name               String
  code               String
  description        String?
  yieldQty           Decimal  @default(1) @db.Decimal(12, 4)
  preparationMinutes Int?     @default(15)
  instructions       String?  @db.Text
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ingredients      RecipeItem[]
  productionOrders ProductionOrder[]
  menuItems        MenuItem[]

  @@unique([companyId, code])
  @@map("recipes")
}

model RecipeItem {
  id               String  @id @default(uuid())
  recipeId         String
  recipe           Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  rawItemId        String
  rawItem          Item    @relation("RawMaterialItem", fields: [rawItemId], references: [id])
  unitId           String?
  unit             Unit?   @relation(fields: [unitId], references: [id])
  quantity         Decimal @db.Decimal(12, 4)
  costContribution Decimal @default(0) @db.Decimal(12, 4)
  notes            String?

  @@unique([recipeId, rawItemId])
  @@map("recipe_items")
}

model ProductionOrder {
  id                 String           @id @default(uuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId           String
  branch             Branch           @relation(fields: [branchId], references: [id])
  kitchenWarehouseId String
  kitchenWarehouse   Warehouse        @relation("KitchenWarehouse", fields: [kitchenWarehouseId], references: [id])
  recipeId           String
  recipe             Recipe           @relation(fields: [recipeId], references: [id])
  orderNumber        String           @unique
  plannedQty         Decimal          @db.Decimal(12, 4)
  actualYieldQty     Decimal          @default(0) @db.Decimal(12, 4)
  wastageQty         Decimal          @default(0) @db.Decimal(12, 4)
  status             ProductionStatus @default(COMPLETED)
  plannedDate        DateTime         @default(now())
  completedDate      DateTime?
  totalRawCost       Decimal          @default(0) @db.Decimal(12, 4)
