model Floor {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floorNumber Int
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms Room[]

  @@unique([branchId, floorNumber])
  @@map("hotel_floors")
}

model RoomType {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name          String
  code          String
  description   String?
  baseOccupancy Int      @default(2)
  maxOccupancy  Int      @default(4)
  baseRate      Decimal  @db.Decimal(12, 4)
  amenities     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rooms     Room[]
  ratePlans RatePlan[]
  bookings  Booking[]

  @@unique([branchId, code])
  @@map("hotel_room_types")
}

model Room {
  id               String     @id @default(uuid())
  companyId        String
  company          Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floorId          String
  floor            Floor      @relation(fields: [floorId], references: [id], onDelete: Cascade)
  roomTypeId       String
  roomType         RoomType   @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  roomNumber       String
  status           RoomStatus @default(AVAILABLE)
  isKeyIssued      Boolean    @default(false)
  currentBookingId String?
  notes            String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  bookings           Booking[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
  lostAndFounds      LostAndFound[]
  roomChangeLogsFrom RoomChangeLog[]     @relation("FromRoom")
  roomChangeLogsTo   RoomChangeLog[]     @relation("ToRoom")

  @@unique([branchId, roomNumber])
  @@map("hotel_rooms")
}

model RatePlan {
  id                 String   @id @default(uuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId           String
  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roomTypeId         String
  roomType           RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  name               String
  code               String
  mealPlan           String   @default("ROOM_ONLY")
  priceMultiplier    Decimal  @default(1.0) @db.Decimal(5, 2)
  cancellationPolicy String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  bookings Booking[]

  @@unique([branchId, code])
  @@map("hotel_rate_plans")
}

model GuestProfile {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String?
  phone       String?
  idType      String?  @default("PASSPORT")
  idNumber    String?
  nationality String?
  address     String?
  vipStatus   String   @default("NONE")
  preferences String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings    Booking[]
  receivables AccountsReceivable[]

  @@map("hotel_guest_profiles")
}

model Booking {
  id               String        @id @default(uuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  guestId          String
  guest            GuestProfile  @relation(fields: [guestId], references: [id])
  roomId           String?
  room             Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomTypeId       String
  roomType         RoomType      @relation(fields: [roomTypeId], references: [id])
  ratePlanId       String?
  ratePlan         RatePlan?     @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  bookingNumber    String        @unique
  checkInDate      DateTime
  checkOutDate     DateTime
  actualCheckIn    DateTime?
  actualCheckOut   DateTime?
  adults           Int           @default(1)
  children         Int           @default(0)
  roomRate         Decimal       @db.Decimal(12, 4)
  totalRoomCharges Decimal       @default(0) @db.Decimal(12, 4)
  extraCharges     Decimal       @default(0) @db.Decimal(12, 4)
  taxAmount        Decimal       @default(0) @db.Decimal(12, 4)
  discountAmount   Decimal       @default(0) @db.Decimal(12, 4)
  grandTotal       Decimal       @default(0) @db.Decimal(12, 4)
  paidAmount       Decimal       @default(0) @db.Decimal(12, 4)
  balanceAmount    Decimal       @default(0) @db.Decimal(12, 4)
  status           BookingStatus @default(CONFIRMED)
  paymentStatus    PaymentStatus @default(PENDING)
  source           String        @default("DIRECT_WALKIN")
  notes            String?
  createdById      String?
  createdBy        User?         @relation("BookingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  folioTransactions FolioTransaction[]
  roomChangeLogs    RoomChangeLog[]
  receivables       AccountsReceivable[]

  @@map("hotel_bookings")
}

model FolioTransaction {
  id              String      @id @default(uuid())
  bookingId       String
  booking         Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactionType FolioTxType
  description     String
  amount          Decimal     @db.Decimal(12, 4)
  referenceId     String?
  recordedById    String?
  createdAt       DateTime    @default(now())

  @@map("hotel_folio_transactions")
}

model RoomChangeLog {
  id             String   @id @default(uuid())
  bookingId      String
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromRoomId     String
  fromRoom       Room     @relation("FromRoom", fields: [fromRoomId], references: [id])
  toRoomId       String
  toRoom         Room     @relation("ToRoom", fields: [toRoomId], references: [id])
  reason         String
  authorizedById String?
  createdAt      DateTime @default(now())

  @@map("hotel_room_change_logs")
}

model HousekeepingTask {
  id           String               @id @default(uuid())
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roomId       String
  room         Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  taskType     HousekeepingTaskType @default(DAILY_CLEAN)
  status       HousekeepingStatus   @default(PENDING)
  priority     String               @default("MEDIUM")
  assignedToId String?
  assignedTo   User?                @relation("Housekeeper", fields: [assignedToId], references: [id], onDelete: SetNull)
  remarks      String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("hotel_housekeeping_tasks")
}

model MaintenanceTicket {
  id           String              @id @default(uuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roomId       String?
  room         Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  title        String
  description  String
  category     MaintenanceCategory @default(OTHER)
  priority     String              @default("MEDIUM")
  status       MaintenanceStatus   @default(OPEN)
  assignedToId String?
  assignedTo   User?               @relation("MaintenanceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  cost         Decimal             @default(0) @db.Decimal(12, 4)
  resolvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("hotel_maintenance_tickets")
}

model LostAndFound {
  id            String             @id @default(uuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roomId        String?
  room          Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  itemName      String
  description   String?
  foundLocation String
  foundDate     DateTime           @default(now())
  foundById     String?
  claimedByName String?
  claimedDate   DateTime?
  status        LostAndFoundStatus @default(FOUND)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("hotel_lost_and_found")
}

model NightAudit {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  auditDate     DateTime
  totalRooms    Int
  occupiedRooms Int
  occupancyRate Decimal  @db.Decimal(5, 2)
  roomRevenue   Decimal  @db.Decimal(12, 4)
  fnbRevenue    Decimal  @db.Decimal(12, 4)
  otherRevenue  Decimal  @db.Decimal(12, 4)
  totalRevenue  Decimal  @db.Decimal(12, 4)
  adr           Decimal  @db.Decimal(12, 4)
  revpar        Decimal  @db.Decimal(12, 4)
  auditedById   String?
  auditedBy     User?    @relation("NightAuditor", fields: [auditedById], references: [id], onDelete: SetNull)
  status        String   @default("SUCCESS")
  notes         String?
