# APEX Multi-Outlet Restaurant ERP — Greenfield Environment Config
NODE_ENV=development
PORT=10000
API_PREFIX=/api/v1

# Neon PostgreSQL Database Connection URL
DATABASE_URL="postgresql://username:password@ep-sample-neon.region.aws.neon.tech/neondb?sslmode=require"

# JWT Security Secrets
JWT_ACCESS_SECRET="apex_erp_jwt_access_secret_change_in_production_2026"
JWT_REFRESH_SECRET="apex_erp_jwt_refresh_secret_change_in_production_2026"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=*
