# APEX Multi-Outlet Restaurant ERP — Greenfield Environment Config
NODE_ENV=development
PORT=10000
API_PREFIX=/api/v1

# Neon PostgreSQL Database Connection URL
DATABASE_URL="postgresql://username:password@ep-sample-neon.region.aws.neon.tech/neondb?sslmode=require"

# JWT Security Secrets
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_RANDOM_SECRET"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id_here"

# CORS Allowed Origins
CORS_ORIGIN="https://YOUR-FRONTEND-DOMAIN"

# AI Provider Abstraction (optional; configure one or more providers)
AI_DEFAULT_PROVIDER=openai
AI_PROVIDER_TIMEOUT_SECONDS=45
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Telegram Notifications (optional; keep secrets server-side)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_DEFAULT_CHAT_ID=""
TELEGRAM_TIMEOUT_SECONDS=15
# Optional inbound Bot API webhook security/integration
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_WEBHOOK_PUBLIC_URL=""
# Optional comma-separated allowlist; empty means linked chats only
TELEGRAM_ALLOWED_CHAT_IDS=""

# WhatsApp Business Cloud API (server-side only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_PUBLIC_URL=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TIMEOUT_SECONDS=15

# Part 32 Security Hardening
# Comma-separated trusted frontend origins. Never use * in production with credentials.
BACKEND_CORS_ORIGINS="https://YOUR-FRONTEND-DOMAIN"
